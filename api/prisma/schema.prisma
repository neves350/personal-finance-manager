generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(uuid())
  googleId     String?       @unique @map("google_id")
  email        String        @unique
  name         String
  passwordHash String?       @map("password_hash")
  avatarUrl    String?       @default("default") @map("avatar_url")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  token        Token[]
  goals        Goal[]
  cards        Card[]
  bankAccounts BankAccount[]
  transfer     Transfer[]
  categories          Category[]
  openBankingCustomer OpenBankingCustomer?

  @@map("users")
}

enum TokenType {
  PASSWORD_RECOVER
}

model Token {
  id        String    @id @default(uuid())
  type      TokenType
  code      String    @unique @db.VarChar(5)
  userId    String    @map("user_id")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tokens")
}

model Goal {
  id            String       @id @default(uuid())
  userId        String       @map("user_id")
  categoryId    String?      @map("category_id")
  bankAccountId String?      @map("bank_account_id")
  title         String
  amount        Decimal      @db.Decimal(12, 2)
  currentAmount Decimal      @default(0) @map("current_amount") @db.Decimal(12, 2)
  startDate     DateTime     @default(now()) @map("start_date")
  endDate       DateTime?    @map("end_date")
  type          GoalType     @default(SAVINGS)
  deposits      Deposit[]
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      Category?    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@map("goals")
}

enum GoalType {
  SAVINGS
  SPENDING_LIMIT
}

model Deposit {
  id        String   @id @default(uuid())
  goalId    String   @map("goal_id")
  amount    Decimal  @db.Decimal(12, 2)
  date      DateTime @default(now())
  note      String?
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("deposits")
}

model Card {
  id             String        @id @default(uuid())
  userId         String        @map("user_id")
  bankAccountId  String        @map("bank_account_id")
  name           String
  color          CardColor     @default(GRAY)
  type           CardType
  lastFour       String?       @map("last_four") @db.VarChar(4)
  expirationDate String?       @map("expiration_date") @db.VarChar(5)
  cvc            String?       @db.VarChar(4)
  isLinked       Boolean       @default(false) @map("is_linked")
  cardNetwork    String?       @map("card_network") @db.VarChar(50)
  creditLimit    Decimal?      @map("credit_limit") @db.Decimal(12, 2)
  closingDay     Int?          @map("closing_day")
  dueDay         Int?          @map("due_day")
  transactions   Transaction[]
  recurrings     Recurring[]
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankAccount    BankAccount   @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@map("cards")
}

enum CardColor {
  GRAY
  RED
  GREEN
  BLUE
  PURPLE
  ORANGE
  YELLOW
  PINK
}

enum CardType {
  CREDIT_CARD
  DEBIT_CARD
}

model BankAccount {
  id                 String              @id @default(uuid())
  userId             String              @map("user_id")
  name               String
  type               BankType            @default(CHECKING)
  balance            Decimal             @db.Decimal(12, 2)
  initialBalance     Decimal             @default(0) @map("initial_balance") @db.Decimal(12, 2)
  isLinked           Boolean             @default(false) @map("is_linked")
  isCardAccount      Boolean             @default(false) @map("is_card_account")
  bankLogo           String?             @map("bank_logo")
  cards              Card[]
  transactions       Transaction[]
  recurrings         Recurring[]
  goals              Goal[]
  transfersFrom      Transfer[]          @relation("from_transfers")
  transfersTo        Transfer[]          @relation("to_transfers")
  openBankingAccount OpenBankingAccount?
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("bank_accounts")
}

enum BankType {
  WALLET
  CHECKING
  SAVINGS
  INVESTMENT
}

enum ConnectionStatus {
  ACTIVE
  INACTIVE
  DISABLED
}

enum TransactionSource {
  MANUAL
  OPEN_BANKING
}

model Transfer {
  id            String         @id @default(uuid())
  userId        String         @map("user_id")
  fromAccountId String         @map("from_account_id")
  toAccountId   String         @map("to_account_id")
  amount        Decimal        @db.Decimal(12, 2)
  date          DateTime
  description   String?
  status        TransferStatus @default(PENDING)
  executedAt    DateTime?      @map("executed_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromAccount   BankAccount    @relation("from_transfers", fields: [fromAccountId], references: [id])
  toAccount     BankAccount    @relation("to_transfers", fields: [toAccountId], references: [id])

  @@map("transfers")
}

enum TransferStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model Category {
  id           String        @id @default(uuid())
  userId       String        @map("user_id")
  title        String
  icon         String
  isDefault    Boolean       @default(false) @map("is_default")
  type         Type
  transactions Transaction[]
  recurrings   Recurring[]
  goals        Goal[]
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("categories")
}

model Transaction {
  id            String            @id @default(uuid())
  cardId        String?           @map("card_id")
  bankAccountId String            @map("bank_account_id")
  categoryId    String            @map("category_id")
  recurringId   String?           @map("recurring_id")
  title         String
  type          Type
  amount        Decimal           @db.Decimal(12, 2)
  date          DateTime
  isPaid        Boolean           @default(false) @map("is_paid")
  source        TransactionSource @default(MANUAL)
  externalId    String?           @unique @map("external_id")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  card          Card?             @relation(fields: [cardId], references: [id], onDelete: Cascade)
  category      Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  bankAccount   BankAccount       @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  recurring     Recurring?        @relation(fields: [recurringId], references: [id], onDelete: SetNull)

  @@map("transactions")
}

model Recurring {
  id              String         @id @default(uuid())
  cardId          String?        @map("card_id")
  bankAccountId   String         @map("bank_account_id")
  categoryId      String         @map("category_id")
  description     String
  type            Type
  amount          Decimal        @db.Decimal(12, 2)
  monthDay        Int?           @map("month_day")
  frequency       Frequency
  paymentMethod   PaymentMethod? @map("payment_method")
  startDate       DateTime       @default(now()) @map("start_date")
  endDate         DateTime?      @map("end_date")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  lastGeneratedAt DateTime?      @map("last_generated_at")
  autoDetected    Boolean        @default(false) @map("auto_detected")
  patternHash     String?        @unique @map("pattern_hash")
  transactions    Transaction[]
  card            Card?          @relation(fields: [cardId], references: [id], onDelete: Cascade)
  category        Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  bankAccount     BankAccount    @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@map("recurrings")
}

enum Type {
  INCOME
  EXPENSE
}

enum Frequency {
  MONTH
  ANNUAL
}

enum PaymentMethod {
  MONEY
  CARD
}

model OpenBankingCustomer {
  id                 String                  @id @default(uuid())
  userId             String                  @unique @map("user_id")
  saltEdgeCustomerId String                  @unique @map("salt_edge_customer_id")
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")
  user               User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  connections        OpenBankingConnection[]

  @@map("open_banking_customers")
}

model OpenBankingConnection {
  id                     String               @id @default(uuid())
  customerId             String               @map("customer_id")
  saltEdgeConnectionId   String               @unique @map("salt_edge_connection_id")
  providerCode           String               @map("provider_code")
  providerName           String               @map("provider_name")
  status                 ConnectionStatus     @default(ACTIVE)
  consentExpiresAt       DateTime?            @map("consent_expires_at")
  lastSyncAt             DateTime?            @map("last_sync_at")
  nextRefreshPossibleAt  DateTime?            @map("next_refresh_possible_at")
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")
  customer               OpenBankingCustomer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  accounts               OpenBankingAccount[]

  @@map("open_banking_connections")
}

model OpenBankingAccount {
  id                 String                @id @default(uuid())
  connectionId       String                @map("connection_id")
  bankAccountId      String                @unique @map("bank_account_id")
  saltEdgeAccountId  String                @unique @map("salt_edge_account_id")
  iban               String?
  currencyCode       String                @default("EUR") @map("currency_code")
  nature             String
  lastSyncAt         DateTime?             @map("last_sync_at")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")
  connection         OpenBankingConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  bankAccount        BankAccount           @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@map("open_banking_accounts")
}
