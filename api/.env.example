# Database
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Auth
# Generate secrets with: openssl rand -hex 32
JWT_SECRET=""
JWT_EXPIRE_IN=15m
JWT_EXPIRE_IN_MS=900000

JWT_REFRESH_SECRET=""
JWT_REFRESH_EXPIRE_IN=7d
JWT_REFRESH_EXPIRE_IN_MS=604800000

# Auth Google
GOOGLE_CLIENT_ID=""
GOOGLE_SECRET=""

# Secure Cookies
USE_SECURE_COOKIES=false  # development
# USE_SECURE_COOKIES=true  # production

# Email (Resend)
MAIL_HOST="smtp.resend.com"
MAIL_PORT=587
MAIL_USER="resend"
MAIL_PASS=""
MAIL_FROM=""

# Salt Edge API
SALT_EDGE_APP_ID=""
SALT_EDGE_SECRET=""
SALT_EDGE_PRIVATE_KEY_PATH=""
SALT_EDGE_WEBHOOK_URL=""
SALT_EDGE_SANDBOX=true

# Frontend
FRONTEND_URL="http://localhost:4200"